    {
      "id": "fred_macro",
      "adapter": "fred",
      "group": "macro",
      "label": "FRED 美联储数据",
      "kind": "macro",
      "points": false,
      "interval": 21600,
      "license": "FRED API Terms",
      "needs_key": "FRED_KEY",
      "url": "https://api.stlouisfed.org/fred/series/observations",
