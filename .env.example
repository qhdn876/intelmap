# ── 全部可选。一个都不填也能跑，只是少几个源 ──
# 缺 key 的源会被 registry 标成「跳过：缺少 XXX」，不会报错刷屏。

# OpenSky：匿名可用但限额低，注册一对免费 client_id/secret 后额度大幅提高
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# 想单独盯的军机/政府机 callsign 前缀（逗号分隔）
OPENSKY_MILITARY_PREFIXES=KM,RMM,RAFR,NAVY,ARMY,VLEN,DAL

# ACLED（非商用免费注册；禁止再分发 → 只适合本地自用）
ACLED_EMAIL=
ACLED_PASSWORD=

# UCDP（研究用途免费 token）
UCDP_TOKEN=

# aisstream.io（免费注册；条款不允许长期留存衍生数据，所以本项目只给 15 分钟 TTL）
AISSTREAM_KEY=

# UN Comtrade：preview 端点免 key，配 key 放宽额度
COMTRADE_KEY=
COMTRADE_REPORTER=156
COMTRADE_PERIOD=2024
COMTRADE_CODES=8542:半导体,2709:原油,3105:化肥,8708:汽车零部件,7108:黄金

# ── 运行调参 ──
PORT=8787
HOST=127.0.0.1
KEEP_DAYS=30
MAX_PARALLEL=2
GDELT_GAP=10000          # GDELT 名义限速 1 请求/5 秒，实测 10 秒才稳
COINGECKO_IDS=bitcoin,ethereum,solana
WB_COUNTRIES=USA,CHN,DEU,JPN,IND,RUS,BRA,GBR,FRA,ITA,KOR,TUR,SAU,IDN,MEX,ZAF,EGY,IRN,UKR,POL
