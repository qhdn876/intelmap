# ── 全部可选。一个都不填也能跑，只是少几个源 ──
# 缺 key 的源会被 registry 标成「跳过：缺少 XXX」，不会报错刷屏。

# Basic Auth：部署到公网时必须设置，格式 user:password
# INTELMAP_AUTH=youruser:yourpassword

# UN Comtrade：preview 端点免 key，配 key 放宽额度
COMTRADE_KEY=
COMTRADE_REPORTER=156
COMTRADE_PERIOD=2024
COMTRADE_CODES=8542:半导体,2709:原油,3105:化肥,8708:汽车零部件,7108:黄金

# FRED 美联储经济数据（免费申请：https://fred.stlouisfed.org/docs/api/api_key.html）
# TODO: 申请后填入并启用 sources.json 里的 fred_macro 源
FRED_KEY=

# ── 运行调参 ──
PORT=8787
HOST=127.0.0.1
KEEP_DAYS=30
MAX_PARALLEL=2
GDELT_GAP=10000          # GDELT 名义限速 1 请求/5 秒，实测 10 秒才稳
WB_COUNTRIES=USA,CHN,DEU,JPN,IND,RUS,BRA,GBR,FRA,ITA,KOR,TUR,SAU,IDN,MEX,ZAF,EGY,IRN,UKR,POL

# RSSHub 实例地址（自托管默认 http://localhost:1200）
# RSSHUB_BASE=http://localhost:1200

# Twitter cookie（RSSHub Twitter 路由需要）
# TODO: 浏览器登录 x.com → F12 → Application → Cookies → auth_token
# TWITTER_AUTH_TOKEN=
